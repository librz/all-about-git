[user]
	name = Patrick Star
	email = p@rick.com
[init]
	defaultBranch = main
[fetch]
	# Auto rm remote-tracking refs that no longer exist on the remote
	prune = true
[pull]
	rebase = true
[push]
	default = current
	autoSetupRemote = true
[alias]

  # common
  sw = switch
  br = branch
  fr = ! git fetch && git rebase
  ds = diff --stat
	pf = push --force-with-lease # safe version of --force
	lc = log --pretty='%Cgreen%h %Creset%an %ar %C(cyan)<%s>' # list commits: https://git-scm.com/docs/pretty-formats
  # list out all branches
  lb = for-each-ref refs/heads/ --sort=-committerdate \
       --format=\"%(committerdate:short) %(color:red)%(objectname:short) %(if)%(HEAD)%(then)%(color:cyan)* %(else)%(color:yellow)%(end)%(refname:short)%(color:reset) (%(color:green)%(committerdate:relative)%(color:reset))\"

	# commit
	cm = commit -m
	ca = commit --amend

	# stash
	sl = stash list
	sa = stash apply
	sp = stash pop
	sm = stash -m

  # shell (with `!` prefix)
	la = ! git config -l | grep -E "^alias" # list all aliases
  lft = ! stat -c %y $(git rev-parse --show-toplevel)/.git/FETCH_HEAD 2>/dev/null || stat -f "%Sm" $(git rev-parse --show-toplevel)/.git/FETCH_HEAD # last fetch time
	st = ! printf '%s' \"last fetched at: \" && git lft && echo && git status   # status (with lft)
  dac = ! git clean -df && git restore . # discard all changes (excluding staged changes)
  # switch to a temporary branch from current branch
  swt = "!f() { \
        local name=\"temp-$(date +'%b%d-%H%M' | tr '[:upper:]' '[:lower:]')\"; \
        git switch -c \"$name\"; \
    }; f"

# Use the personal SSH key for any repository under ~/personal/
[includeIf "gitdir:~/personal/"]
    path = ~/.gitconfig-personal
